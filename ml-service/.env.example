# ============================================
# ML Service Environment Configuration
# ============================================

# Server
PORT=5000

# TensorFlow Settings
TF_CPP_MIN_LOG_LEVEL=2
TF_FORCE_GPU_ALLOW_GROWTH=true

# Performance
OMP_NUM_THREADS=1
TF_NUM_INTRAOP_THREADS=1
TF_NUM_INTEROP_THREADS=1